# Copy this file to .env and fill in real values ONLY if you want to run
# against real providers. The default (mock) requires none of this.

# "mock" (default, no credentials needed) or "real"
TRANSCRIPTION_ADAPTER=mock
EXTRACTION_ADAPTER=mock

MAX_UPLOAD_MB=25

# Only required when TRANSCRIPTION_ADAPTER=real
STT_API_KEY=
STT_PROVIDER_URL=

# Only required when EXTRACTION_ADAPTER=real
OCR_API_KEY=
OCR_PROVIDER_URL=